#!/bin/sh
# Copy to .git/hooks/pre-commit or use with pre-commit framework
# Genetic tag: repo.tooling.genetic_starter.agentstack_dx.gen1

# --- Secret scan (block commits with likely credentials) ---
# Patterns: AGENTSTACK_API_KEY values, Bearer tokens in source (not templates)
SCAN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -Ev '\.(png|jpg|jpeg|gif|webp|ico|woff2?|pdf|zip|lock)$' || true)

if [ -n "$SCAN_FILES" ]; then
  for f in $SCAN_FILES; do
    [ -f "$f" ] || continue
    case "$f" in
      *.sample|*.template|*.example|.env.example|docs/dependabot*|**/pre-commit.sample)
        continue
        ;;
    esac
    if grep -En 'AGENTSTACK_API_KEY\s*=\s*[^[:space:]#]+' "$f" 2>/dev/null | grep -Ev '=\s*$|=\s*<|=\s*your_|=\s*ask_xxx'; then
      echo "pre-commit: possible AGENTSTACK_API_KEY secret in $f"
      exit 1
    fi
    if grep -En 'Bearer [A-Za-z0-9._-]{20,}' "$f" 2>/dev/null; then
      echo "pre-commit: possible Bearer token in $f"
      exit 1
    fi
  done
fi

# Placeholder allowlist — lines matching these are OK
# AGENTSTACK_API_KEY=
# Bearer <token>

if [ -f tools/genetic-ai-starter/scripts/doctor.mjs ]; then
  node tools/genetic-ai-starter/scripts/doctor.mjs --target . || exit 1
fi
