# AgentStack consumer project — copy to .env.local (never commit secrets)
# Genetic tag: repo.platform.sdk.onboarding.gen1

# REST API base (production default when unset: https://agentstack.tech/api)
AGENTSTACK_API_BASE=https://agentstack.tech/api

# Project-scoped API key (ask_…) — narrow service_caps; optional when using session login
AGENTSTACK_API_KEY=

# Active tenant project (X-Project-ID); required for most writes
AGENTSTACK_PROJECT_ID=

# OAuth Bearer for MCP (Cursor plugin /agentstack-init Device Code flow)
# Written to ~/.cursor/mcp.json by the plugin; use here for scripts that call POST /mcp
AGENTSTACK_ACCESS_TOKEN=

# Optional — email/password login for SDK recipes (00-bootstrap, etc.)
# AGENTSTACK_EMAIL=
# AGENTSTACK_PASSWORD=
